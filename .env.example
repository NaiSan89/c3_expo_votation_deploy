PORT=3000
HOST=127.0.0.1
# Em produção, use a URL HTTPS exata, sem barra final.
PUBLIC_ORIGIN=http://localhost:3000
# Troque por uma senha longa e aleatória. Sem ela, a exportação fica desativada.
ADMIN_TOKEN=
EVENT_LAT=-23.540972222222223
EVENT_LNG=-46.734
EVENT_RADIUS_METERS=200
# A leitura deve ter precisão de até 50 m e caber inteira no raio.
MAX_ACCURACY_METERS=50
VOTING_OPEN=true
DATABASE_PATH=./data/votes.sqlite
# Na Vercel, use a URL de conexão PostgreSQL com pool fornecida pelo provedor.
DATABASE_URL=
# Com Google Sheets na Vercel, defina um segredo aleatório para a tarefa agendada.
CRON_SECRET=

# Google Sheets opcional. Crie uma aba Votos vazia e compartilhe com a conta de serviço.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Votos
# Caminho de um JSON secreto, fora da pasta public e fora do Git.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternativa ao arquivo: conteúdo JSON completo em uma única variável secreta.
GOOGLE_SERVICE_ACCOUNT_JSON=
